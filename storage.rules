rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Storage Admin check: requires verified master admin email or Firestore /admins/{uid} registration
    function isAdmin() {
      return isSignedIn() && (
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mirzayevulugbek024@gmail.com'
      );
    }

    // Odiljon Qori recitations: public can stream and listen; only authenticated admin can upload or replace
    match /recitations/odiljon-qori/{surahFile} {
      allow read: if true;
      allow write: if isAdmin() 
        && request.resource.size < 250 * 1024 * 1024 // max 250MB
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
