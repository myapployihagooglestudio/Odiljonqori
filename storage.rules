rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Storage Admin check: strictly requires single permanent admin UID 'odiljon-qori-permanent-admin'
    // and either custom token claim isPermanentAdmin == true or active /admins/odiljon-qori-permanent-admin document.
    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == 'odiljon-qori-permanent-admin'
        && (
          request.auth.token.get('isPermanentAdmin', false) == true ||
          (
            firestore.exists(/databases/(default)/documents/admins/odiljon-qori-permanent-admin) &&
            firestore.get(/databases/(default)/documents/admins/odiljon-qori-permanent-admin).data.isActive == true
          )
        );
    }

    // Odiljon Qori recitations: public can stream and listen; only the single permanent admin can upload or replace
    match /recitations/odiljon-qori/{surahFile} {
      allow read: if true;
      allow write: if isAdmin() 
        && request.resource.size < 250 * 1024 * 1024 // max 250MB
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
