# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# ==============================================================================
# ODILJON QORI QUR'ON — FIREBASE CLIENT CONFIGURATION (6 REQUIRED VARIABLES)
# Configure these in Google AI Studio Secrets or local .env (never commit secrets)
# Leave empty here so placeholder strings are never mistaken for real credentials.
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==============================================================================
# ODILJON QORI QUR'ON — SERVER-SIDE PERMANENT ADMIN AUTHENTICATION SECRETS
# Configure these strictly in server environment / Google AI Studio Secrets.
# Never expose these variables with VITE_ prefix and never commit real values.
# ==============================================================================
ADMIN_INITIAL_USERNAME=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_SESSION_SECRET=""

# ==============================================================================
# FIREBASE ADMIN SDK CREDENTIALS (FOR CUSTOM TOKEN MINTING & SERVER VERIFICATION)
# Provide either the full Service Account JSON string in FIREBASE_SERVICE_ACCOUNT_KEY
# or provide FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY.
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
