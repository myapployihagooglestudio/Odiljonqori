rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin authorization check: verifies against trusted /admins collection or master verified admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mirzayevulugbek024@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Admins management collection: only admins can view or register new admin accounts
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Surahs: Public can only read published surahs. Admin has full control.
    match /surahs/{surahId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();

      // Ayahs subcollection under surah
      match /ayahs/{ayahId} {
        allow read: if get(/databases/$(database)/documents/surahs/$(surahId)).data.isPublished == true || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Admin audit logs: only verified admins can read and create, immutable
    match /admin_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Version snapshots: only verified admins can read and create, immutable
    match /version_snapshots/{snapshotId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // User bookmarks and listening history: private to each user
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /bookmarks/{bookmarkId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /history/{historyId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // System collection: readable for healthcheck, write is strictly restricted to admin
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
