rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Fixed single permanent administrator UID
    function isPermanentAdminUid() {
      return isSignedIn() && request.auth.uid == 'odiljon-qori-permanent-admin';
    }

    // Admin authorization check: strictly verifies the single permanent administrator identity
    // (uid == 'odiljon-qori-permanent-admin') and active administrator status.
    // All email-based and multi-admin authorization has been completely removed.
    function isAdmin() {
      return isPermanentAdminUid() && (
        request.auth.token.get('isPermanentAdmin', false) == true ||
        (
          exists(/databases/$(database)/documents/admins/odiljon-qori-permanent-admin) &&
          get(/databases/$(database)/documents/admins/odiljon-qori-permanent-admin).data.isActive == true &&
          get(/databases/$(database)/documents/admins/odiljon-qori-permanent-admin).data.role == 'admin'
        )
      );
    }

    // Single permanent administrator record:
    // Only the single document 'odiljon-qori-permanent-admin' can exist.
    // Creating any additional admin account (adminId != 'odiljon-qori-permanent-admin') is strictly forbidden.
    match /admins/{adminId} {
      allow get: if isPermanentAdminUid() && adminId == 'odiljon-qori-permanent-admin';
      allow list: if false;
      allow create, update: if isPermanentAdminUid()
        && adminId == 'odiljon-qori-permanent-admin'
        && request.resource.data.uid == 'odiljon-qori-permanent-admin'
        && request.resource.data.role == 'admin'
        && request.resource.data.isActive == true;
      allow delete: if false;
    }

    // Surahs: Public can only read published surahs. Single permanent admin has full control.
    match /surahs/{surahId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();

      // Ayahs subcollection under surah
      match /ayahs/{ayahId} {
        allow read: if get(/databases/$(database)/documents/surahs/$(surahId)).data.isPublished == true || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Admin audit logs: only verified single permanent admin can read and create, immutable
    match /admin_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Version snapshots: only verified single permanent admin can read and create, immutable
    match /version_snapshots/{snapshotId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // User bookmarks and listening history: private to each user
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /bookmarks/{bookmarkId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /history/{historyId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // System collection: readable for healthcheck, write is strictly restricted to single permanent admin
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
